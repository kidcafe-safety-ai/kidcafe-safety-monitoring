# SQLite DB path inside the API container.
KIDCAFE_DB_PATH=/app/outputs/kidcafe_events.db

# Editable Zone Settings runtime file. Must be the same volume file the Vision AI
# pipeline reads via --zones (host: outputs/zones_runtime.json).
KIDCAFE_ZONES_PATH=/app/outputs/zones_runtime.json

# React Dashboard Docker mode.
VITE_API_MODE=api
VITE_API_BASE_URL=http://localhost:8000
